---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectCard from '@components/ProjectCard.astro';
import SectionBar from '@components/SectionBar.astro';
import { projects } from '../../data/projects';
---

<BaseLayout
    title="Proyectos · Vladimir Besser"
    description="Proyectos de Vladimir Besser: MU Rankings, agintis, atrium y Domos Lago Rapel, hechos con Go, Python, PostgreSQL y Kubernetes."
>
    <SectionBar
        id="projects"
        title="Proyectos"
    />
    <p class="mb-4">Estos son algunos de los proyectos que he desarrollado.</p>
    {projects.map((project) => <ProjectCard {...project} />)}
</BaseLayout>
