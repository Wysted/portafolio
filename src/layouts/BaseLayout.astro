---
import Navbar from '@components/NavBar.astro';
import Bubbles from '@components/Bubbles.astro';
import '@fontsource/dotgothic16';
import '@styles/global.css';

interface Props {
    title?: string;
    description?: string;
}
const {
    title = 'Vladimir Besser · Backend developer',
    description = 'Vladimir Besser, desarrollador backend: Go, Python/FastAPI, PostgreSQL y Kubernetes.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const lastUpdate = new Date().toISOString().slice(0, 10).replaceAll('-', '.');
---

<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        />
        <link
            rel="icon"
            type="image/svg+xml"
            href="/favicon.svg"
        />

        <title>{title}</title>
        <meta
            name="description"
            content={description}
        />
        <meta
            property="og:title"
            content={title}
        />
        <meta
            property="og:description"
            content={description}
        />
        <meta
            property="og:type"
            content="website"
        />
        <link
            rel="canonical"
            href={canonical}
        />
        <meta
            property="og:url"
            content={canonical}
        />
        <meta
            property="og:image"
            content={ogImage}
        />
        <meta
            property="og:image:width"
            content="1200"
        />
        <meta
            property="og:image:height"
            content="630"
        />
        <meta
            property="og:image:alt"
            content="Vladimir Besser, desarrollador backend: Go, Python, PostgreSQL y Kubernetes"
        />
        <meta
            property="og:locale"
            content="es_CL"
        />
        <meta
            name="twitter:card"
            content="summary_large_image"
        />
    </head>
    <body>
        <Bubbles />
        <div class="mx-auto max-w-page bg-page sm:border-x sm:border-border">
            <header class="px-2 pt-4 text-center">
                <h1 class="font-pixel text-[32px] leading-tight">Vladimir Besser</h1>
                <p class="text-xs">Backend developer / Go · FastAPI · PostgreSQL</p>
                <div class="my-2 flex items-center gap-2 border-y border-rule py-1">
                    <div class="min-w-0 flex-1 overflow-hidden">
                        <p
                            id="marquee"
                            class="inline-block animate-marquee pl-[100%] whitespace-nowrap motion-reduce:animate-none motion-reduce:pl-0"
                        >
                            ¡Bienvenido/a!
                        </p>
                    </div>
                    <button
                        id="marquee-stop"
                        type="button"
                        aria-pressed="false"
                        class="hidden shrink-0 cursor-pointer border border-ink bg-menu px-1 font-pixel text-xs motion-reduce:hidden"
                    >
                        <span aria-hidden="true" id="marquee-icon">■ </span><span id="marquee-label">Detener</span>
                    </button>
                </div>
            </header>
            <div class="sm:grid sm:grid-cols-[150px_1fr]">
                <Navbar />
                <main class="min-w-0 p-2 sm:px-4">
                    <slot />
                </main>
            </div>
            <footer class="border-t border-rule px-2 py-4 text-center text-xs">
                <p>Última actualización {lastUpdate}</p>
                <p>En línea desde 2025.07.30</p>
                <p>Probado en: Firefox, Chrome 1024x768</p>
                <p>
                    [<a
                        href="/VladimirBesserCv.pdf"
                        target="_blank"
                        rel="noopener">CV (PDF)</a
                    >]
                </p>
                <p>(C) 2026 Vladimir Besser</p>
            </footer>
        </div>
        <script>
            const marquee = document.getElementById('marquee');
            const stop = document.getElementById('marquee-stop');
            stop?.classList.remove('hidden');
            stop?.addEventListener('click', () => {
                const stopped = marquee?.classList.toggle('stopped');
                const icon = document.getElementById('marquee-icon');
                const label = document.getElementById('marquee-label');
                stop.setAttribute('aria-pressed', String(stopped));
                if (icon) icon.textContent = stopped ? '▶ ' : '■ ';
                if (label) label.textContent = stopped ? 'Reanudar' : 'Detener';
            });
        </script>
    </body>
</html>
