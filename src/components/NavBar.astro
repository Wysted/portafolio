---
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

// Bullet colors cycle through the PC-98 palette (except black), like Abe's menu.
const items = [
    { label: 'Inicio', href: '/', bullet: 'text-pc98-red' },
    { label: 'Perfil', href: '/#profile', bullet: 'text-pc98-green' },
    { label: 'Experiencia', href: '/#experience', bullet: 'text-pc98-cyan' },
    { label: 'Proyectos', href: '/projects', bullet: 'text-pc98-yellow' },
    { label: 'Stack', href: '/#tech', bullet: 'text-pc98-blue' },
    { label: 'Contacto', href: '/#contact', bullet: 'text-pc98-magenta' },
];
---

<nav
    aria-label="Menú principal"
    class="border-b border-border bg-menu p-2 sm:border-r sm:border-b-0 sm:p-3"
>
    <ul class="flex flex-wrap sm:block">
        {
            items.map((item) => {
                const current = item.href === currentPath;
                return (
                    <li class="sm:mb-3 not-last:after:mx-1 not-last:after:content-['|'] sm:not-last:after:content-none">
                        <span
                            aria-hidden="true"
                            class={`mr-1 hidden sm:inline ${item.bullet}`}
                        >
                            ●
                        </span>
                        <a
                            href={item.href}
                            aria-current={current ? 'page' : undefined}
                            class={current ? 'font-bold' : ''}
                        ><span class="font-pixel text-sm">{item.label}</span></a>
                        {current && (
                            <span
                                aria-hidden="true"
                                class="hidden sm:inline"
                            >
                                {' '}
                                ◀
                            </span>
                        )}
                    </li>
                );
            })
        }
    </ul>
</nav>
