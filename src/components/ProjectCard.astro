---
import TechIcon from '@components/TechIcon.astro';
const { title, description, tech = [], github, demo, wip } = Astro.props;

const main = demo ?? github;
const links = [
    { label: 'GitHub', href: github },
    { label: 'Sitio', href: demo },
].filter((l) => l.href);
---

<article class="mb-4 border border-border p-2">
    <h3 class="font-bold">
        {main ? <a href={main}>{title}</a> : title}
        {
            wip && (
                <span class="ml-2 inline-block bg-accent px-1 text-xs whitespace-nowrap text-on-accent">
                    En construcción
                </span>
            )
        }
    </h3>
    <p class="mb-2">{description}</p>
    <p class="mb-2 flex flex-wrap gap-1">
        {tech.map((t: string) => <TechIcon name={t} />)}
    </p>
    <p>
        {
            links.map((l) => (
                <span class="mr-2">
                    [<a href={l.href} target="_blank" rel="noopener">{l.label}</a>]
                </span>
            ))
        }
    </p>
</article>
