---
import SectionBar from '@components/SectionBar.astro';

const banner =
    'inline-block h-[31px] border border-ink px-2 font-pixel text-xs leading-[29px] text-ink no-underline visited:text-ink active:text-ink';
---

<section class="mb-4">
    <SectionBar
        id="contact"
        title="Contacto"
    />
    <p class="mb-2">
        ¿Te interesa colaborar o tienes alguna consulta? Estoy disponible para trabajar en APIs,
        backends, proyectos web e infraestructura.
    </p>
    <p class="mb-2 flex flex-wrap gap-2">
        <a
            href="mailto:vladimirbesser@gmail.com"
            class={`${banner} bg-pastel-pink`}>Mail</a
        >
        <a
            href="https://www.linkedin.com/in/vladimir-besser-a4898a253/"
            target="_blank"
            rel="noopener"
            class={`${banner} bg-pastel-cyan`}>LinkedIn</a
        >
        <a
            href="https://github.com/Wysted"
            target="_blank"
            rel="noopener"
            class={`${banner} bg-box`}>GitHub</a
        >
    </p>
    <p>
        [<a href="mailto:vladimirbesser@gmail.com">vladimirbesser@gmail.com</a>]
    </p>
</section>
